{
  "name": "umd-tennis-reserve",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "poll": "node scripts/poll.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "ci": "npm run typecheck && npm run test && npm run build",
    "prepare": "node -e \"require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'inherit'})\""
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "source-map-js": "1.2.2"
  }
}
