# Required for email notifications (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx

# Sender address. Use onboarding@resend.dev for testing,
# or your verified domain (e.g. Alerts <alerts@yourdomain.com>)
EMAIL_FROM=UMD Tennis Alerts <onboarding@resend.dev>

# Required on Vercel (ephemeral filesystem). Free at https://upstash.com
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Required in production — protects /api/poll from public abuse.
# Use the same value as the Bearer token in cron-job.org / Vercel cron.
CRON_SECRET=change-me-to-a-long-random-string

# Signs verify/unsubscribe email links (falls back to CRON_SECRET if unset)
TOKEN_SECRET=another-long-random-string

# Public site URL — used in email links (verify / unsubscribe / booking CTAs)
APP_URL=https://your-app.vercel.app

# Optional: force email verification on/off (default: on when RESEND_API_KEY is set)
# REQUIRE_EMAIL_VERIFY=true

# Optional: Sentry DSN for error reporting
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
